		<style id="wp-custom-css">
			section.elementor-section.elementor-top-section.elementor-element.elementor-element-75f4560c.elementor-section-stretched.elementor-section-boxed.elementor-section-height-default.elementor-section-height-default {
    width: 132% !important;
}


 .elementor-field-group:not(.elementor-field-type-upload) .elementor-field:not(.elementor-select-wrapper) {
    background-color: #ffffff;
    border-width: 0px 0px 0px 0px;
    border-radius: 33px 33px 33px 33px;
    padding: 10px 16px;
}
.elementor-kit-10 p{
	margin:10px ;
}
.button-color {
    background-color: #06379a !important;
    color: #FFF !important;
    font-size: 1em;
    padding: 10px 30px !important;
    border-radius: 30px !important;
}
.paoc-credit-wrp {
    display: none;
}

.box {
    /* display: flex; */
    background: white;
    display: flex;
    justify-content: space-around;
    align-items: center;
    border-radius: 40px;
    /* max-width: 500px; */
    width: 80%;
    box-shadow: 0 3px 10px rgb(0 0 0 / 20%);
}
input.wpcf7-form-control.wpcf7-number.wpcf7-validates-as-number {
    border: none;
}
span.wpcf7-spinner {
    display: none;
}
input.wpcf7-form-control.has-spinner.wpcf7-submit {
    padding: 12px 20px;
    border-radius: 30px;
    font-size: 13px;
	background-color: #06379a;
	    text-decoration: none;
}

/* call / whatsapp button */
.displayflex .elementor-button-icon{
	display:flex;
	justify-content:center;
	align-items:center;
	width:50px;
	height:50px;
	font-size:22px
}

form#wpforms-form-2122 {
       background: white;
    display: flex;
    justify-content: space-around;
    align-items: center;
    border-radius: 31px;
    max-width: 500px;
    width: 100%;
	  box-shadow: 0 3px 10px rgb(0 0 0 / 0.2);
}
div.wpforms-container-full {
  margin: 0px auto;
}
button#wpforms-submit-2122 {
    margin-bottom: 10px !important;
	
}
div#wpforms-2122-field_1-container {
    padding: 0;
}
input#wpforms-2122-field_1 {
    width: 100%;
    border: 0;
    background: white;
	  margin-right:45px
}
/* footer bottom css last child */
.elementor-icon-list-item.elementor-inline-item {
  border-right: 2px solid #fff;
  padding-right: 15px !important;
}
.elementor-icon-list-item.elementor-inline-item:last-child{
	border:none;
}
img.border-radius {
    border-radius: 30px;
}
.slide-style{
	display:flex;
	align-items:center;
}
/* mobile css */
@media (max-width: 767px) {
	
	.box {
    width: 100%;
}
	input.wpcf7-form-control.has-spinner.wpcf7-submit {
    padding: 12px;
    font-size: 11px;
}
	input.wpcf7-form-control.wpcf7-number.wpcf7-validates-as-number {
    font-size: 13px;
}
	
	.elementor-5500 .elementor-element.elementor-element-3b35997 .elementor-field-group:not(.elementor-field-type-upload) .elementor-field:not(.elementor-select-wrapper) {
    padding: 10px 16px;
}
	
	button#wpforms-submit-2122 {
    margin-bottom: 10px !important;
    margin-right: 10px;
    font-size: 12px;
}
	input#wpforms-2122-field_1 {
    margin-left: 5px;
}
	.htslider-slider .slick-arrow {
    height: 35px;
    width: 35px;
		top: 39%;
}
	.typing:hover > .elementor-element-populated .elementor-heading-title{
		color: #043754 !important;
	}
	
.form-s div.wpforms-container .wpforms-form .choices[data-type*="select-one"]:after {
    right: -140.5px !important;
}
.form-s div.wpforms-container .wpforms-form .choices__inner {
    width: 260% !important;
    border-radius: 30px !important;
    margin-left: -36px;
		    font-size: 14px;

}
	
	
	
}
input::-webkit-outer-spin-button,
input::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

input[type=number] {
    -moz-appearance:textfield;
}
/* get an offer btn css */
.btn-offer-css .elementor-button-text{
	flex-grow:unset;
	padding-right: 10px;
}
.btn-offer-css .elementor-button-link.elementor-button.elementor-size-xl {
  width: 50%;
  padding: 0 !important;
}
.btn-offer-css .elementor-button-content-wrapper{
	justify-content: left;
}
		</style>
		</head>

